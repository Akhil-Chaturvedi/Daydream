<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ backup.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user settings -->
        <include domain="sharedpref" path="daydream_settings.xml"/>
        <include domain="sharedpref" path="DaydreamSettings.xml"/>
        <!-- Cache directories are excluded from backup by default -->
        <!-- MediaPlaybackPrefs.xml is not included above, so it is already excluded -->
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="daydream_settings.xml"/>
        <include domain="sharedpref" path="DaydreamSettings.xml"/>
        <!-- Cache directories are excluded from backup by default -->
    </device-transfer>
</data-extraction-rules>