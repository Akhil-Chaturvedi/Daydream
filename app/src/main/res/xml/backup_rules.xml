<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Daydream settings persistence.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Include user settings for backup -->
    <include domain="sharedpref" path="daydream_settings.xml"/>
    <include domain="sharedpref" path="DaydreamSettings.xml"/>
    
    <!-- Cache directories are excluded from backup by default -->
    <!-- MediaPlaybackPrefs.xml is not included above, so it is already excluded -->
</full-backup-content>